      "name": "Validar ID y sitio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body;const keys=Object.keys(b??{}).sort().join(',');if(!b||!(keys==='destination,nonce,postId'||keys==='destination,nonce,postId,projection'&&b.projection==='editorial')||!['OPURO','OPOL','LIBERAL'].includes(b.destination)||!Number.isSafeInteger(b.postId)||b.postId<1||!/^cms_[a-f0-9]{48}$/.test(b.nonce))throw Error('INVALID_CMS_OBSERVATION_SCOPE');return [{json:{...b,startedAt:new Date().toISOString()}}];"
      }
    },
