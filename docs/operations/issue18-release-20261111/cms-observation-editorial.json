    {
      "id": "5c227222-1263-4bad-b2a0-850e3d1c0c6b",
      "name": "Observación CMS sin permiso de escritura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json,s=$('Validar ID y sitio').first().json,p=r.body;let post=null;if(r.statusCode===200&&p&&p.id===s.postId&&p.type==='post'&&typeof p.slug==='string'&&['publish','draft','trash','future','private','pending'].includes(p.status)){post={id:p.id,type:p.type,slug:p.slug,status:p.status,modifiedGmt:p.modified_gmt??null};if(s.projection==='editorial'){for(const k of ['title','content','excerpt','featured_media','author','categories','tags','meta'])if(Object.hasOwn(p,k))post[k]=p[k];}}return [{json:{schema:'opmx.cms-observation.v1',destination:s.destination,postId:s.postId,nonce:s.nonce,startedAt:s.startedAt,observedAt:new Date().toISOString(),statusCode:r.statusCode,post,writeAuthorized:false,...(s.projection==='editorial'?{projection:'editorial'}:{})}}];"
      }
    },
