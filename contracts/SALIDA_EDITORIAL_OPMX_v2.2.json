                  "not_public",
                  "partially_public",
                  "public"
                ]
              },
              "editorial_treatment": {
                "type": "string"
              }
            }
          }
        },
        "related_disputes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "matter",
              "relationship",
              "resolved_by_current_event"
