              "type": "string"
            }
          },
          "normalization_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "PASS_DIRECT",
              "PASS_REDIRECT_RESOLVED",
              "PASS_CANONICAL_RESOLVED",
              "WARNING_PARTIAL",
              "HUMAN_REQUIRED",
              "BLOCKED",
              null
            ]
          },
          "normalization_warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "modified_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "file_size_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "word_count": {
            "type": "integer",
            "minimum": 0
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "extraction_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "facts",
        "additional_sources",
        "discrepancies",
        "unverified_data"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "partially_verified",
            "warning",
            "blocked"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim",
              "status",
              "source",
              "attribution_required"
            ],
            "properties": {
              "claim": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "VERIFIED",
                  "ATTRIBUTED_VERIFIED",
                  "UNVERIFIED",
                  "CONFLICTING"
                ]
              },
              "source": {
                "type": "string"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "attribution_required": {
                "type": "boolean"
              },
              "primary_document_public": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "primary_document_expected_from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "public_source_checked": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "additional_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url",
              "type",
              "purpose"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        },
        "discrepancies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "description",
              "severity",
              "action"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "minor",
                  "major",
                  "critical"
                ]
              },
              "action": {
                "type": "string"
              }
            }
          }
        },
        "unverified_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_documents_pending": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "document",
              "expected_publisher",
              "status",
