          ],
          "properties": {
            "estimated_score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "target_score_met": {
              "type": "boolean"
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "test",
                  "status",
                  "reason"
                ],
                "properties": {
                  "test": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "WARNING_EDITORIAL",
                      "NOT_APPLICABLE",
                      "FAIL"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "suggested_fix": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "editorial_exceptions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "test",
                  "decision",
                  "justification"
                ],
                "properties": {
                  "test": {
                    "type": "string"
                  },
                  "decision": {
                    "type": "string"
                  },
                  "justification": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
