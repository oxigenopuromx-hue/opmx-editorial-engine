        "keyword_copy_block"
      ],
      "properties": {
        "focus_keyword": {
          "type": "string"
        },
        "secondary_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seo_title": {
          "type": "string"
        },
        "seo_title_length": {
          "type": "integer"
        },
        "meta_description": {
          "type": "string"
        },
        "meta_description_length": {
          "type": "integer"
        },
        "slug": {
          "type": "string"
        },
        "slug_length": {
          "type": "integer"
        },
        "full_url": {
          "type": "string"
        },
        "full_url_length": {
          "type": "integer"
        },
        "keyword_density_percent": {
          "type": [
            "number",
            "null"
          ]
        },
        "keyword_copy_block": {
          "type": "string"
        },
        "cannibalization": {
          "type": "object",
          "required": [
            "status",
            "warning",
            "recommendation"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "clear",
                "possible",
                "high_risk",
                "unknown"
              ]
            },
            "warning": {
              "type": "string"
            },
            "recommendation": {
              "type": "string"
            }
          }
        },
        "rank_math_analysis": {
          "type": "object",
          "required": [
            "estimated_score",
            "target_score_met",
