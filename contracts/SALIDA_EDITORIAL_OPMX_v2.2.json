{
  "schema_name": "SALIDA_EDITORIAL — OXÍGENO PURO MX",
  "schema_version": "2.2",
  "protocol_id": "OPMX-4.2",
  "purpose": "Contrato de salida estructurada para que Claude entregue información editorial, SEO, WordPress, imagen, Schema y control de calidad de forma procesable por una automatización.",
  "rules": {
    "format": "JSON",
    "valid_json_required": true,
    "no_markdown_fences": true,
    "no_comments": true,
    "no_unresolved_placeholders": true,
    "no_internal_reasoning": true,
    "preserve_empty_arrays": true,
    "preserve_null_when_not_applicable": true
  },
  "top_level_fields": [
    "protocol",
    "ingestion",
    "ingestion_dossier",
    "sources",
    "url_normalization",
    "verification",
    "article",
    "seo",
    "wordpress",
    "image",
    "schema",
    "quality_control"
  ],
  "properties": {
    "protocol": {
      "type": "object",
      "required": [
        "protocol_name",
        "protocol_version",
        "protocol_id",
        "config_name",
        "config_version"
      ],
      "properties": {
        "protocol_name": {
          "type": "string"
        },
        "protocol_version": {
          "type": "string"
        },
        "protocol_id": {
          "type": "string"
        },
        "config_name": {
          "type": "string"
        },
        "config_version": {
          "type": "string"
        }
      }
    },
    "ingestion": {
      "type": "object",
      "required": [
        "source_count",
        "multi_source",
        "overall_status",
        "warnings",
        "web_source_count",
        "document_source_count",
        "direct_text_source_count",
        "total_words",
        "blocked_source_count",
        "usable_source_count"
      ],
      "properties": {
        "source_count": {
          "type": "integer"
        },
        "multi_source": {
          "type": "boolean"
        },
        "overall_status": {
          "type": "string",
          "enum": [
            "ready",
            "partial",
            "blocked"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "web_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "document_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "direct_text_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_words": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "usable_source_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
