        "jsCode": "const get=n=>$(n).first(0,0).json;const expect=(v,s)=>{if(v.status!==s)throw Error('Estado QA no esperado: '+s);};if(!['OPEN','OPEN_REPLAY'].includes(get('QA abrir paquete').status))throw Error('Paquete QA no abierto');if(!['STORED','RESERVATION_REPLAY'].includes(get('QA reservar texto').status))throw Error('Texto QA no guardado');expect(get('QA reservar PDF'),'RESERVED');expect(get('QA cerrar pendiente'),'NOT_READY');expect(get('QA completar PDF'),'STORED');expect(get('QA repetir PDF'),'STORED_REPLAY');expect(get('QA repetir reserva'),'RESERVATION_REPLAY');expect(get('QA recuperar original'),'FOUND');if(get('QA recuperar original').contentBase64!=='JVBERi0xLjQKZml4dHVyZQ=='||get('QA recuperar original').bytes!==16)throw Error('Original QA distinto');expect(get('QA cerrar completo'),'READY');expect(get('QA repetir cierre'),'READY');const manifest=get('QA leer manifiesto');if(manifest.state!=='READY'||manifest.items.length!==2||manifest.items.some(i=>i.state!=='STORED'))throw Error('Manifiesto QA inválido');if(!manifest.items.some(i=>i.kind==='TEXT'&&i.text_content===\"SOLO QA. No publicar. México, comas y apóstrofe '.\"))throw Error('UTF8 QA distinto');expect(get('QA sesión final'),'NO_OPEN_PACKAGE');return [{json:{status:'STORAGE_FIXTURE_VERIFIED',originalBytes:16,items:2,duplicateReservationChecked:true,duplicateWriteChecked:true,pendingCloseBlocked:true,sealVerified:true,publicationCalled:false}}];"
