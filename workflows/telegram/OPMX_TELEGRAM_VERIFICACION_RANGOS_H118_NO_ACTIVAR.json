    {
      "id": "8cc34885-77ab-47f6-b4c0-6112e4242551",
      "name": "Verificar estado y huellas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg=$('Configurar paquete privado').first(0,0).json,m=$('Leer manifiesto privado').first(0,0).json;const summary={package_id:cfg.packageId,status:'NOT_CONFIRMED',range_reads_verified:false,state:m.state??'UNKNOWN',revision:Number(m.revision)||0,item_count:0,stored_count:0,total_file_bytes:0,items_json:'[]',checked_at:$now.toISO()};const inputs=$input.all();try{const failure=$('Preparar originales para huella nativa').first(0,0).json;if(failure.verification_role==='failure')summary.status='NOT_CONFIRMED:'+failure.failure_reason;}catch{}if(inputs.length===4&&inputs.every(x=>x.json.computed_sha256===x.json.expected_sha256&&/^[a-f0-9]{64}$/.test(x.json.computed_sha256??''))){const items=inputs.filter(x=>x.json.verification_role==='original').map(x=>({itemId:x.json.itemId,mime:x.json.mime,bytes:x.json.bytes,sha256:x.json.computed_sha256}));summary.status='PACKAGE_VERIFIED';summary.range_reads_verified=true;summary.item_count=m.items.length;summary.stored_count=m.items.filter(i=>i.state==='STORED').length;summary.total_file_bytes=items.reduce((n,i)=>n+i.bytes,0);summary.items_json=JSON.stringify(items);}return [{json:summary}];"
      }
