    {
      "id": "0dc3f430-ee9e-4225-9952-fb62d8ad0326",
      "name": "Preparar originales para huella nativa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "try{const cfg=$('Configurar paquete privado').first(0,0).json,m=$('Leer manifiesto privado').first(0,0).json;if(m.status!=='FOUND'||m.packageId!==cfg.packageId||m.state!=='READY'||!Array.isArray(m.items)||m.items.length!==3||m.items.some(i=>i.state!=='STORED'))return [{json:{failed:true}}];const outputs=cfg.assets.map((expect,i)=>{const a=$('Recuperar original privado '+i).first(0,0).json,meta=m.items.find(x=>x.item_id===expect.itemId);if(a.status!=='FOUND'||a.packageId!==cfg.packageId||a.itemId!==expect.itemId||a.bytes!==expect.bytes||a.attachment?.mime_type!==expect.mime||meta?.sha256!==a.sha256)throw Error('Original no confirmado');const bytes=Buffer.from(a.contentBase64,'base64');if(bytes.length!==expect.bytes)throw Error('Tamaño no confirmado');return {json:{itemId:expect.itemId,mime:expect.mime,bytes:bytes.length,expected_sha256:a.sha256,verification_role:\"original\"},binary:{data:{data:a.contentBase64,mimeType:expect.mime,fileName:'source'}}};});const range=$('Verificar rango original privado').first(0,0).json,text=$('Verificar texto privado').first(0,0).json;for(const [r,role]of [[range,'range'],[text,'text']]){if(r.status!=='FOUND'||r.packageId!==cfg.packageId||!Number.isSafeInteger(r.bytes)||r.bytes<1||!/^[a-f0-9]{64}$/.test(r.chunkSha256??''))throw Error('Fragmento no confirmado');const bytes=Buffer.from(r.contentBase64,'base64');if(bytes.length!==r.bytes)throw Error('Rango incompleto');if(role==='range'){const index=cfg.assets.findIndex(x=>x.mime==='application/pdf');const raw=Buffer.from($('Recuperar original privado '+index).first(0,0).json.contentBase64,'base64');if(r.offset!==31||r.bytes!==100||r.contentBase64!==raw.subarray(31,131).toString('base64'))throw Error('Rango distinto del original');}else{const source=m.items.find(x=>x.item_id===r.itemId);if(r.offset!==0||!r.eof||r.contentBase64!==Buffer.from(source?.text_content??'','utf8').toString('base64'))throw Error('Texto distinto del manifiesto');}outputs.push({json:{itemId:r.itemId,mime:r.mime_type,bytes:r.bytes,expected_sha256:r.chunkSha256,verification_role:role},binary:{data:{data:r.contentBase64,mimeType:r.mime_type,fileName:'source'}}});}return outputs;}catch(e){const known=['Original no confirmado','Tamaño no confirmado','Fragmento no confirmado','Rango incompleto','Rango distinto del original','Texto distinto del manifiesto'];return [{json:{verification_role:'failure',failure_reason:known.includes(e.message)?e.message:'preparacion'}}];}"
      }
    },
