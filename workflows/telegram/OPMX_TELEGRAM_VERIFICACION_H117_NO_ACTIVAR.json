    {
      "id": "0dc3f430-ee9e-4225-9952-fb62d8ad0326",
      "name": "Preparar originales para huella nativa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg=$('Configurar paquete privado').first(0,0).json,m=$('Leer manifiesto privado').first(0,0).json;if(m.status!=='FOUND'||m.packageId!==cfg.packageId||m.state!=='READY'||!Array.isArray(m.items)||m.items.length!==3||m.items.some(i=>i.state!=='STORED'))return [{json:{failed:true}}];return cfg.assets.map((expect,i)=>{const a=$('Recuperar original privado '+i).first(0,0).json,meta=m.items.find(x=>x.item_id===expect.itemId);if(a.status!=='FOUND'||a.packageId!==cfg.packageId||a.itemId!==expect.itemId||a.bytes!==expect.bytes||a.attachment?.mime_type!==expect.mime||meta?.sha256!==a.sha256)throw Error('Original no confirmado');const bytes=Buffer.from(a.contentBase64,'base64');if(bytes.length!==expect.bytes)throw Error('Tamaño no confirmado');return {json:{itemId:expect.itemId,mime:expect.mime,bytes:bytes.length,expected_sha256:a.sha256},binary:{data:{data:a.contentBase64,mimeType:expect.mime,fileName:'source'}}};});"
      }
    },
