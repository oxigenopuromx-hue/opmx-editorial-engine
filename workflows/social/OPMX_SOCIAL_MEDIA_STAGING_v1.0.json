{
  "name": "OPMX Social Media Staging v1.0 — WordPress Temporary",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "opmx-social/media-staging-v1",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "8cba1099-029b-47b5-87af-0c9c87014df1",
      "name": "Webhook — Stage Social Asset",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -720,
        100
      ],
      "webhookId": "d9dd739b-bbfc-4f6f-88d5-98c0650cb603"
    },
    {
      "parameters": {
        "jsCode": "const p=$input.first(); const j=p.json; const s=j.media?.social; if(j.event?.source_site!=='OPURO'||!j.event?.source_post_id||!s||s.source_type!=='UPLOAD'||!s.binary_property||!s.mime_type||!s.filename) throw new Error('SOCIAL_MEDIA_STAGING_INPUT_INVALID'); if(!p.binary?.[s.binary_property]) throw new Error('SOCIAL_MEDIA_BINARY_MISSING'); if(!['image/jpeg','image/png','image/webp'].includes(s.mime_type)) throw new Error('SOCIAL_MEDIA_MIME_UNSUPPORTED'); const safe=String(s.filename).replace(/[^a-zA-Z0-9._-]+/g,'-'); const filename=`social-${j.event.source_post_id}-${j.event.event_id}-${safe}`; return [{json:{...j,staging:{filename,mime_type:s.mime_type,binary_property:s.binary_property}},binary:p.binary}];"
      },
      "id": "4d6aee7f-7dd0-42bc-b4a8-0454024077d4",
      "name": "Validate SOCIAL Asset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.OPMX_SOCIAL_WP_BASE_URL || '').replace(/\\/$/, '') + '/wp-json/wp/v2/media' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Disposition",
              "value": "={{ 'attachment; filename=\"' + $json.staging.filename + '\"' }}"
            },
            {
              "name": "Content-Type",
              "value": "={{ $json.staging.mime_type }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "={{ $json.staging.binary_property }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "56705e76-af3c-4dc1-93c3-40b36e686eaf",
      "name": "WordPress — Upload Temporary SOCIAL Asset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "stopWorkflow",
      "credentials": {
        "httpBasicAuth": {
          "name": "OPMX Social WordPress"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const upload=$input.first().json; const ctx=$node['Validate SOCIAL Asset'].json; if(!upload?.id||!upload?.source_url) throw new Error('WORDPRESS_SOCIAL_MEDIA_UPLOAD_NOT_CONFIRMED'); const days=ctx.execution?.cleanup_after_days||7; const cleanup=new Date(Date.now()+days*86400000).toISOString(); return [{json:{...ctx,asset:{wordpress_media_id:upload.id,public_url:upload.source_url,mime_type:upload.mime_type||ctx.staging.mime_type,immutable:false,temporary:true,uploaded_at:new Date().toISOString(),cleanup_after:cleanup}}}];"
      },
      "id": "a6780fc0-b973-4a1e-ac92-691e0b6163d2",
      "name": "Return WordPress Social Asset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        100
      ]
    }
  ],
