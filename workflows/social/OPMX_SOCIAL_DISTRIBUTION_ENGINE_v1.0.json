        "jsCode": "const p=$input.first().json; const platforms=['x','linkedin','google_business','facebook','instagram','threads','tiktok','youtube','whatsapp_channel']; const crypto=require('crypto'); if(!p.asset?.public_url||!p.asset?.wordpress_media_id) throw new Error('OPMX_SOCIAL_WORDPRESS_STAGING_REQUIRED'); return platforms.map(platform=>({json:{...p,platform,platform_idempotency_key:crypto.createHash('sha256').update(`${p.event.event_id}:${platform}:${p.social_contract_version}`).digest('hex')}}));"
      },
