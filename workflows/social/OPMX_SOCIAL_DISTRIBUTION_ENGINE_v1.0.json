        "jsCode": "const p=$input.first().json;\nconst platforms=['x','linkedin','google_business','facebook','instagram','threads','tiktok','youtube','whatsapp_channel'];\nif(p.social_contract_version!=='1.0'||p.event?.source_site!=='OPURO'||!p.event?.event_id||!p.event?.source_post_id||!p.content?.titulo_seo||!p.content?.subtitulo||!p.content?.url_opuro||p.media?.social?.source_type!=='UPLOAD'||!p.media?.social?.binary_property) throw new Error('OPMX_SOCIAL_CONTRACT_V1_INVALID');\nif(!p.targets||platforms.some(platform=>!Object.prototype.hasOwnProperty.call(p.targets,platform))) throw new Error('OPMX_SOCIAL_TARGETS_INCOMPLETE');\nreturn [{json:{...p,social_engine_version:'1.0',run_id:p.execution?.correlation_id||p.event.event_id,correlation_id:p.execution?.correlation_id||p.event.event_id},binary:$input.first().binary}];"
      },
