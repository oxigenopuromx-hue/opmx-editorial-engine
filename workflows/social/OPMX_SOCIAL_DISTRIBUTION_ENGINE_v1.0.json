    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst target = p.targets[p.platform];\nconst manual = p.platform === 'youtube' || p.platform === 'whatsapp_channel' || target?.manual_required;\nconst status = !target?.enabled || manual || p.execution?.dry_run ? 'SKIPPED' : 'FAILED';\nconst reason = !target?.enabled || p.execution?.dry_run ? 'DISABLED' : manual ? 'MANUAL_REQUIRED' : 'MISSING_CREDENTIAL';\nreturn [{json:{platform:p.platform,status,idempotency_key:p.platform_idempotency_key,attempts:0,started_at:new Date().toISOString(),completed_at:new Date().toISOString(),post_id:null,post_url:null,provider_request_id:null,asset_url:p.asset?.public_url || null,reason_code:reason,error:status==='FAILED'?{code:'PLATFORM_WORKER_NOT_CONFIGURED'}:null}}];"
      },
