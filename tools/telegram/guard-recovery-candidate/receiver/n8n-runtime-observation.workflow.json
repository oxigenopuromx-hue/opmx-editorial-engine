        "jsCode": "const scope=$('Validar alcance').first().json;const ids=[\"bnzVMNkZuGO1GQCZ\",\"Mt7ts2EGPbyaTC2o\",\"4o7K5TmKc7joScqB\"];\nconst workflows=ids.map((id,i)=>{const r=$('Leer versión '+i).first().json;const b=r.body,a=b?.activeVersion;if(r.statusCode!==200||b.id!==id||b.active!==true||!a||a.workflowId!==id||a.versionId!==b.activeVersionId||!Array.isArray(a.nodes)||!a.connections)throw Error('ACTIVE_VERSION_UNAVAILABLE');return {id,activeVersionId:b.activeVersionId,graph:{nodes:a.nodes,connections:a.connections}}});\nconst executionPages=['running','waiting','new'].map(status=>{const r=$('Leer '+status).first().json;const b=r.body;if(r.statusCode!==200||!Array.isArray(b?.data))throw Error('EXECUTION_PAGE_UNAVAILABLE');if(b.data.some(x=>x.status!==status||typeof x.id!=='string'||typeof x.workflowId!=='string'))throw Error('EXECUTION_FILTER_MISMATCH');return {status,complete:!b.nextCursor,executions:b.data.filter(x=>ids.includes(x.workflowId)).map(x=>({id:x.id,workflowId:x.workflowId,status:x.status,startedAt:x.startedAt??null,stoppedAt:x.stoppedAt??null}))}});\nreturn [{json:{schema:'opmx.runtime-observation.v1',scope:{packageId:scope.packageId,revision:scope.revision,eventId:scope.eventId,nonce:scope.nonce},startedAt:scope.startedAt,observedAt:new Date().toISOString(),workflows,executionPages,authorizesRecovery:false,motorTerminationVerified:false}}];"
